<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WordMaster" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        
        <!-- Primary Brand Colors (Keep consistent) -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryDark">@color/blue_primary_dark</item>
        <item name="colorAccent">@color/blue_accent</item>

        <!-- True Black Backgrounds -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>

        <!-- White Text -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
        
        <!-- Card & Surface Colors - Ensure they are black too, unless specific card contrast is desired, 
             but user said "All screen backgrounds must be pure black". 
             Material3 Cards usually have a surface tint. We might need to override card styling. -->
        <item name="cardBackgroundColor">@color/black</item>

        <!-- Button Style Override -->
        <item name="materialButtonStyle">@style/Widget.WordMaster.Button</item>
    </style>
    
    <style name="Theme.WordMaster" parent="Base.Theme.WordMaster" />

    <style name="Widget.WordMaster.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="iconTint">@color/black</item>
    </style>
</resources>