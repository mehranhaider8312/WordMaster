<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_primary"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <View
            android:id="@+id/decorCircle1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:alpha="0.1"
            android:background="@drawable/circle_shape"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-20dp"
            android:layout_marginEnd="-20dp" />

        <View
            android:id="@+id/decorCircle2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.1"
            android:background="@drawable/circle_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="-10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="110dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:id="@+id/imgIntro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="40dp"
                    android:src="@drawable/logo_app"
                    android:scaleType="fitCenter" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Learn New Words"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textAlignment="center"
                android:alpha="0"/>

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expand your vocabulary with daily word challenges"
                android:textAlignment="center"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:alpha="0"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:id="@+id/featuresContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:alpha="0">

                <LinearLayout
                    android:id="@+id/feature1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/feature_card_bg"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/iconFeature1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_book"
                        android:layout_marginEnd="16dp"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/txtFeature1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add words with meanings and examples"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/feature_card_bg"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/iconFeature2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginEnd="16dp"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/txtFeature2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Track your progress and mastery level"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/feature_card_bg">

                    <ImageView
                        android:id="@+id/iconFeature3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_brain"
                        android:layout_marginEnd="16dp"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/txtFeature3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Practice with interactive quizzes"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>