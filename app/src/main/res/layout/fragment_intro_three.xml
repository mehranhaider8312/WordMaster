<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_light"
    android:fillViewport="true"
    tools:context=".view.fragments.IntroFragmentThree">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <View
            android:id="@+id/decorGlobe1"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:alpha="0.22"
            android:background="@drawable/globe_shape"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="-10dp" />

        <View
            android:id="@+id/decorGlobe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:alpha="0.22"
            android:background="@drawable/globe_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="60dp"
            android:layout_marginStart="-5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_black"
                android:text="Learn in Your Language"
                android:textColor="@color/blue_primary"
                android:textSize="24sp"
                android:textAlignment="center"
                android:letterSpacing="-0.02"
                android:alpha="0"/>

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Support for multiple languages to enhance your learning experience"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/inter"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:alpha="0"
                android:layout_marginBottom="24dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtGlobeEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🌍"
                        android:textSize="60sp"
                        android:layout_marginBottom="14dp"
                        android:scaleX="0"
                        android:scaleY="0"/>

                    <LinearLayout
                        android:id="@+id/languagesGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:alpha="0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:id="@+id/langEnglish"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/language_card_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🇬🇧"
                                    android:textSize="30sp"
                                    android:layout_marginBottom="5dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="English"
                                    android:textColor="@color/blue_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inter_medium"
                                    android:letterSpacing="-0.01"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/langUrdu"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/language_card_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🇵🇰"
                                    android:textSize="30sp"
                                    android:layout_marginBottom="5dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urdu"
                                    android:textColor="@color/blue_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inter_medium"
                                    android:letterSpacing="-0.01"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <LinearLayout
                                android:id="@+id/langArabic"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/language_card_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🇸🇦"
                                    android:textSize="30sp"
                                    android:layout_marginBottom="5dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Arabic"
                                    android:textColor="@color/blue_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inter_medium"
                                    android:letterSpacing="-0.01"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/langMore"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/language_card_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="➕"
                                    android:textSize="30sp"
                                    android:layout_marginBottom="5dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="More Coming"
                                    android:textColor="@color/blue_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inter_medium"
                                    android:letterSpacing="-0.01"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/featuresContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:alpha="0">

                <LinearLayout
                    android:id="@+id/feature1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/feature_card_bg"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/iconFeature1"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🔄"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Switch between languages seamlessly"
                        android:textColor="@color/blue_primary"
                        android:fontFamily="@font/inter"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/feature_card_bg"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/iconFeature2"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="📚"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Learn words with native translations"
                        android:textColor="@color/blue_primary"
                        android:fontFamily="@font/inter"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/feature_card_bg">

                    <TextView
                        android:id="@+id/iconFeature3"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✨"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Personalized learning in your preferred language"
                        android:textColor="@color/blue_primary"
                        android:fontFamily="@font/inter"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>