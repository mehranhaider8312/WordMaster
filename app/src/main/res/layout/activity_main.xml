<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_light"
    tools:context=".view.activities.MainActivity">

    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="menu"
        android:padding="12dp"
        android:src="@drawable/ic_ellipse"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:tint="@color/blue_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/txtStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:text="@string/streak_placeholder"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/blue_primary"
        app:icon="@drawable/ic_fire"
        app:iconTintMode="src_atop"
        app:iconTint="@null"
        app:iconSize="28dp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:strokeWidth="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/groupButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStreak">

        <com.yalantis.library.Koloda
            android:id="@+id/swipeAbleCardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:koloda_card_layout="@layout/item_word_card"
            app:koloda_card_scale_diff="0.04"
            app:koloda_card_offsetY="16dp"
            app:koloda_card_rotate_angle="15"
            app:koloda_max_visible_cards="9"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/groupButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStreak">

        <ImageView
            android:id="@+id/ivReloadWords"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:src="@drawable/ic_refresh"
            app:tint="@color/blue_primary_dark"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieEmptyState"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/loading_cat"
            app:lottie_autoPlay="false"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reload or Add Some Words"
            android:gravity="center"
            android:textColor="@color/blue_primary"
            android:textSize="16sp"
            android:fontFamily="@font/inter_semibold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bannerAdContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReview"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/review"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_timer"
            app:iconPadding="10dp"
            app:iconSize="28dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:backgroundTint="@color/blue_primary_dark"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddWord"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/add_word"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:icon="@drawable/add"
            app:iconPadding="10dp"
            app:iconSize="28dp"
            app:iconGravity="textStart"
            android:backgroundTint="@color/blue_primary"
            app:iconTint="@color/white"
            app:strokeColor="@color/blue_primary"
            app:strokeWidth="2dp"
            android:textColor="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bannerAdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>